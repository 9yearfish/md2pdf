{
  "name": "md2pdf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/e2e.mjs && node scripts/autosave.mjs && node scripts/font-tiers.mjs && node scripts/i18n.mjs && node scripts/math.mjs && node scripts/mermaid.mjs && node scripts/pages.mjs --no-samples && node scripts/landing.mjs && node scripts/ai-paste.mjs && node scripts/print.mjs && node scripts/ux.mjs",
    "fonts": "python3 scripts/prepare_fonts.py",
    "test:scripts": "node scripts/scripts-render.mjs",
    "test:pages": "node scripts/pages.mjs",
    "icons": "python3 scripts/icons.py",
    "indexnow": "node scripts/indexnow.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.3",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "markdown-it": "^15.0.2",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.0.0",
    "temml": "^0.13.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "binaryen": "^132.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "description": "Markdown to PDF in the browser, with Mermaid diagrams and Chinese typesetting. Nothing is uploaded."
}
